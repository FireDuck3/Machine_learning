
# ==========================================
# Завдання 1. Градієнт і крок навчання
# ==========================================

def error(w):
    return (w - 8) ** 2


def gradient(w):
    return 2 * (w - 8)


w = 12
lr = 0.1

print("Завдання 1")
print("Початкова вага:", w)
print("Початкова помилка:", error(w))
print("Градієнт:", gradient(w))

w = w - lr * gradient(w)

print("Вага після оновлення:", w)
print("Помилка після оновлення:", error(w))


# ==========================================
# Завдання 2. Підбір швидкості навчання
# ==========================================

print("\nЗавдання 2")

for lr in [0.01, 0.1, 0.5, 0.9, 1.1]:
    w = 12
    old_error = error(w)

    w = w - lr * gradient(w)
    new_error = error(w)

    print(
        f"lr = {lr}: "
        f"нова вага = {w:.2f}, "
        f"нова помилка = {new_error:.2f}, "
        f"зменшилась = {new_error < old_error}"
    )


# ==========================================
# Завдання 3. Знайти найбільший lr,
# за якого помилка зменшується
# ==========================================

print("\nЗавдання 3")

w_start = 12
old_error = error(w_start)

# Для цієї функції помилка зменшується,
# коли 0 < lr < 1.
# lr = 1 дає таку саму помилку, як спочатку.
# Тому найбільшого значення, яке строго зменшує
# помилку, немає: можна наближатися до 1 знизу.

for lr in [0.9, 0.99, 0.999, 1.0, 1.1]:
    w = w_start
    w = w - lr * gradient(w)
    new_error = error(w)

    print(
        f"lr = {lr}: вага = {w:.3f}, "
        f"помилка = {new_error:.6f}"
    )


# ==========================================
# Завдання 4. Два параметри та перевірка
# градієнтів через малу зміну ваг
# ==========================================

def error2(w1, w2):
    return (w1 - 3) ** 2 + (w2 - 3) ** 2


def gradient_w1(w1):
    return 2 * (w1 - 3)


def gradient_w2(w2):
    return 2 * (w2 - 3)


w1 = 2
w2 = 2
lr = 0.1

print("\nЗавдання 4")
print("Початкова помилка:", error2(w1, w2))

# Аналітичні градієнти
g1 = gradient_w1(w1)
g2 = gradient_w2(w2)

print("Градієнт w1:", g1)
print("Градієнт w2:", g2)

# Чисельна перевірка градієнтів
delta = 0.001

numeric_g1 = (
    error2(w1 + delta, w2) - error2(w1, w2)
) / delta

numeric_g2 = (
    error2(w1, w2 + delta) - error2(w1, w2)
) / delta

print("Чисельний градієнт w1:", numeric_g1)
print("Чисельний градієнт w2:", numeric_g2)

# Обчислюємо обидві нові ваги зі старих значень
new_w1 = w1 - lr * g1
new_w2 = w2 - lr * g2

# Оновлюємо ваги одночасно
w1, w2 = new_w1, new_w2

print("Новий w1:", w1)
print("Новий w2:", w2)
print("Нова помилка:", error2(w1, w2))


# ==========================================
# Завдання 5. Нульові градієнти
# ==========================================

def error3(w1, w2):
    return (w1 * w2 - 1) ** 2


def gradient3_w1(w1, w2):
    return 2 * (w1 * w2 - 1) * w2


def gradient3_w2(w1, w2):
    return 2 * (w1 * w2 - 1) * w1


w1 = 0
w2 = 0
lr = 0.1

print("\nЗавдання 5")
print("Початкова помилка:", error3(w1, w2))

for step in range(5):
    g1 = gradient3_w1(w1, w2)
    g2 = gradient3_w2(w1, w2)

    new_w1 = w1 - lr * g1
    new_w2 = w2 - lr * g2

    w1, w2 = new_w1, new_w2

    print(
        f"Крок {step + 1}: "
        f"w1 = {w1}, w2 = {w2}, "
        f"помилка = {error3(w1, w2)}, "
        f"градієнти = ({g1}, {g2})"
    )

print(
    "Висновок: обидва градієнти дорівнюють нулю, "
    "тому ваги не змінюються, а помилка залишається 1."
)
